<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:defaultValue="@string/settings_system_mode_display"
        android:entries="@array/pref_ui_mode_entries"
        android:entryValues="@array/pref_ui_mode_values"
        android:icon="@drawable/ic_settings_display"
        android:key="@string/preference_key_ui_mode"
        android:summary="Dark mode preferences"
        android:title="Display settings" />

    <SwitchPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_swipe"
        android:key="@string/preference_key_swipe"
        android:summaryOn="@string/settings_swipe_on"
        android:summaryOff="@string/settings_swipe_off"
        android:title="@string/settings_swipe_title" />

    <PreferenceCategory android:title="@string/settings_news_category">

        <!-- entries are filled in by the SettingsFragment from the countries / languages supported by the API -->
        <ListPreference
            android:icon="@drawable/ic_headlines"
            android:key="@string/preference_key_country"
            android:title="@string/settings_country_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:icon="@drawable/ic_search"
            android:key="@string/preference_key_language"
            android:title="@string/settings_language_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

</PreferenceScreen>